# Обязательные секреты
# API_KEY обязателен, compose упадёт, если переменная не задана.
API_KEY=example

# PostgreSQL
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments

# Подключение к postgres, опубликованному на localhost.
# В docker-compose.yml этот URL переопределяется на postgres:5432
# (сервисное имя внутри сети compose).
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Outbox publisher
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=100

# Retry / DLQ 
PROCESS_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=5000
RETRY_MULTIPLIER=2.0
RETRY_MAX_DELAY_MS=300000

# Эмуляция платёжного шлюза
GATEWAY_MIN_LATENCY=2.0
GATEWAY_MAX_LATENCY=5.0
GATEWAY_SUCCESS_RATE=0.9

# Webhook 
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_BASE_DELAY=0.5
WEBHOOK_TIMEOUT=10.0
# false по умолчанию: блокирует обращение к private/loopback/cloud metadata IP.
# Включайте true только для локальной разработки, если webhook-приёмник
# поднят на localhost или в приватной сети.
WEBHOOK_ALLOW_PRIVATE_HOSTS=true

# Локально, true, если webhook приёмник поднят на localhost.
WEBHOOK_ALLOW_PRIVATE_HOSTS=true